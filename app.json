{
  "expo": {
    "name": "Plouto",
    "slug": "plouto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "plouto",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.plouto.wealth",
      "buildNumber": "4",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Plouto uses Face ID to lock your financial data on this device."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "da059e17-40d3-42bf-af14-ca33dec31cc8"
      }
    }
  }
}
